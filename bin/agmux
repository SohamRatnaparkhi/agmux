#!/usr/bin/env bash
# agmux — a thin manager layer over tmux for coding agents (claude/opencode/grok/codex/pi).
# It never talks to the agents themselves; it only lists/creates tmux panes and,
# for Claude, reads the public `claude agents --json` roster for blocked/busy glyphs.
#
#   agmux              picker: type a name to jump to a live agent; + new is last
#   agmux <words>      jump to a matching live agent (e.g. agmux turbopuffer)
#   agmux new          spawn an agent: pick repo -> pick agent -> new/resume
#   agmux here         spawn an agent in the current repo (skips the repo picker)
#   agmux resume       pick a past session and restart it in the same CLI
#   agmux search       type a query, open it in the default browser
#   agmux menu         tap-friendly menu: new, here, search, sweep, live jump, ○ restart
#   agmux sweep        close inactive agents and leftover agent-only sessions
#                      (never the session you are in). --all closes live ones too. --dry-run lists.
#   agmux path         pick a repo, print its absolute path (for `p` shell func)
#   agmux status       tiny status-bar summary, cached ("✋2 ▶5")
#   agmux root ...     manage which folders agmux scans (add/rm/list)
#   agmux repos        rescan roots now, print how many repos were found
#   agmux clean        remove finished worktrees (in-use/dirty/unmerged are kept)
#   agmux web on|off   browser terminal at your tailnet URL (ttyd + tailscale serve)
#   agmux jump <pane>  focus a pane by id (used by menu)
set -uo pipefail

SELF="${BASH_SOURCE[0]:-$0}"
AGMUX_HOME="${AGMUX_HOME:-$HOME/.agmux}"
CACHE="$AGMUX_HOME/repos"
WT_DIR="$AGMUX_HOME/worktrees"
ROOTS_FILE="$AGMUX_HOME/roots"
# pre-rename worktree dirs: still pruned by `agmux clean`, never written to
LEGACY_WT="$HOME/.ax/worktrees"
LEGACY_WT2="$HOME/.amux/worktrees"
HUB_SESSIONS='^(ax-hub|agmux-hub)$'
AGENT_CHOICES="claude
opencode
grok
codex
pi
shell"

# full launch command per agent. $2 = new|continue|pick
# (flags verified against the installed binaries)
launch_cmd() {
  local agent="$1" mode="${2:-new}"
  case "$agent" in
    claude)
      case "$mode" in
        continue) echo "claude --dangerously-skip-permissions --continue";;
        pick)     echo "claude --dangerously-skip-permissions --resume";;
        *)        echo "claude --dangerously-skip-permissions";;
      esac;;
    codex)
      case "$mode" in
        continue) echo "codex --dangerously-bypass-approvals-and-sandbox resume --last";;
        pick)     echo "codex --dangerously-bypass-approvals-and-sandbox resume";;
        *)        echo "codex --dangerously-bypass-approvals-and-sandbox";;
      esac;;
    opencode)
      case "$mode" in
        continue) echo "opencode --auto --continue";;
        pick)     echo "opencode --auto --continue";;
        *)        echo "opencode --auto";;
      esac;;
    grok)
      case "$mode" in
        continue) echo "grok --always-approve --continue";;
        pick)     echo "grok --always-approve --resume";;
        *)        echo "grok --always-approve";;
      esac;;
    pi)
      case "$mode" in
        continue) echo "pi --continue";;
        pick)     echo "pi --resume";;
        *)        echo "pi";;
      esac;;
    *) echo "$1";;
  esac
}

# Resume a specific saved session by id. Flags verified against the installed
# binaries (create + resume-by-id + TUI, 2026-08-16, /tmp/agmux-resume-probe).
resume_cmd() {
  local agent="$1" id="$2"
  case "$agent" in
    claude)   echo "claude --dangerously-skip-permissions --resume $id";;
    grok)     echo "grok --always-approve --resume $id";;
    opencode) echo "opencode --auto --session $id";;
    pi)       echo "pi --session $id";;
    codex)    echo "codex --dangerously-bypass-approvals-and-sandbox resume $id";;
    *)        echo "$agent";;
  esac
}

# One row per saved chat, newest first:
#   mtime<TAB>agent<TAB>id<TAB>cwd<TAB>title
# Reads each CLI's own store. Does not talk to the agents.
list_history() {
  python3 - <<'PY'
import glob, json, os, subprocess, time, urllib.parse

home = os.path.expanduser("~")
rows = []

def add(mtime, agent, sid, cwd, title):
    if not sid:
        return
    title = " ".join((title or "").replace("\t", " ").split())
    if len(title) > 90:
        title = title[:87] + "..."
    rows.append((float(mtime or 0), agent, sid, cwd or "", title or sid[:8]))

def first_text(obj):
    if obj is None:
        return ""
    if isinstance(obj, str):
        return obj.strip()
    if isinstance(obj, list):
        parts = []
        for x in obj:
            if isinstance(x, dict) and x.get("text"):
                parts.append(x["text"])
            elif isinstance(x, str):
                parts.append(x)
        return " ".join(parts).strip()
    if isinstance(obj, dict):
        return first_text(obj.get("text") or obj.get("content"))
    return ""

# --- claude: ~/.claude/projects/<enc>/*.jsonl ---
croot = os.path.join(home, ".claude", "projects")
if os.path.isdir(croot):
    for d in os.listdir(croot):
        dd = os.path.join(croot, d)
        if not os.path.isdir(dd):
            continue
        for f in glob.glob(os.path.join(dd, "*.jsonl")):
            sid = os.path.splitext(os.path.basename(f))[0]
            if len(sid) < 8:
                continue
            cwd = title = None
            try:
                with open(f, "r", encoding="utf-8", errors="replace") as fh:
                    for i, line in enumerate(fh):
                        if i > 120:
                            break
                        try:
                            o = json.loads(line)
                        except json.JSONDecodeError:
                            continue
                        cwd = cwd or o.get("cwd")
                        if title or o.get("type") != "user":
                            continue
                        t = first_text((o.get("message") or {}).get("content") if isinstance(o.get("message"), dict) else o.get("message") or o.get("content"))
                        if t.startswith("<") or t.startswith("/"):
                            continue
                        if t:
                            title = t
            except OSError:
                continue
            add(os.path.getmtime(f), "claude", sid, cwd, title)

# --- grok: ~/.grok/sessions/<urlenc-cwd>/<id>/ ---
groot = os.path.join(home, ".grok", "sessions")
if os.path.isdir(groot):
    for d in os.listdir(groot):
        dd = os.path.join(groot, d)
        if not os.path.isdir(dd):
            continue
        try:
            cwd = urllib.parse.unquote(d)
        except Exception:
            cwd = d
        if not cwd.startswith("/"):
            continue
        for sid in os.listdir(dd):
            p = os.path.join(dd, sid)
            if not os.path.isdir(p):
                continue
            title = None
            mtime = os.path.getmtime(p)
            sm = os.path.join(p, "summary.json")
            if os.path.isfile(sm):
                try:
                    o = json.load(open(sm, encoding="utf-8"))
                    title = (o.get("session_summary") or "").strip() or None
                    cwd = (o.get("info") or {}).get("cwd") or cwd
                    ua = o.get("updated_at") or ""
                    if ua:
                        # 2026-08-16T19:31:00Z
                        try:
                            from datetime import datetime, timezone
                            mtime = datetime.fromisoformat(ua.replace("Z", "+00:00")).timestamp()
                        except Exception:
                            pass
                except Exception:
                    pass
            if not title:
                ch = os.path.join(p, "chat_history.jsonl")
                if os.path.isfile(ch):
                    try:
                        with open(ch, encoding="utf-8", errors="replace") as fh:
                            for line in fh:
                                o = json.loads(line)
                                if o.get("type") != "user":
                                    continue
                                t = first_text(o.get("content"))
                                if t and t.lower() not in ("list", "y", "n") and len(t) > 2:
                                    title = t
                                    break
                    except Exception:
                        pass
            add(mtime, "grok", sid, cwd, title)

# --- pi: ~/.pi/agent/sessions/<enc>/*.jsonl ---
proot = os.path.join(home, ".pi", "agent", "sessions")
if os.path.isdir(proot):
    for f in glob.glob(os.path.join(proot, "*", "*.jsonl")):
        sid = cwd = title = None
        try:
            with open(f, encoding="utf-8", errors="replace") as fh:
                for i, line in enumerate(fh):
                    if i > 80:
                        break
                    try:
                        o = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if o.get("type") == "session":
                        sid = o.get("id")
                        cwd = o.get("cwd")
                    elif o.get("type") == "message" and not title:
                        m = o.get("message") or {}
                        if m.get("role") in ("user", None):
                            t = first_text(m.get("content"))
                            if t:
                                title = t
        except OSError:
            continue
        if sid:
            add(os.path.getmtime(f), "pi", sid, cwd, title)

# --- opencode: official JSON list ---
try:
    raw = subprocess.check_output(
        ["opencode", "session", "list", "--format", "json", "-n", "200"],
        stderr=subprocess.DEVNULL, text=True, timeout=8,
    )
    for s in json.loads(raw):
        mtime = s.get("updated") or s.get("created") or 0
        if mtime > 1e12:
            mtime = mtime / 1000.0
        add(mtime, "opencode", s.get("id"), s.get("directory"), s.get("title"))
except Exception:
    pass

# --- codex: ~/.codex/session_index.jsonl (for /resume-codex) ---
idx = os.path.join(home, ".codex", "session_index.jsonl")
if os.path.isfile(idx):
    try:
        with open(idx, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                try:
                    o = json.loads(line)
                except json.JSONDecodeError:
                    continue
                sid = o.get("id")
                title = o.get("thread_name") or o.get("title")
                ua = o.get("updated_at") or ""
                mtime = os.path.getmtime(idx)
                if ua:
                    try:
                        from datetime import datetime
                        mtime = datetime.fromisoformat(ua.replace("Z", "+00:00")).timestamp()
                    except Exception:
                        pass
                add(mtime, "codex", sid, o.get("cwd") or "", title)
    except OSError:
        pass

rows.sort(reverse=True)
for mtime, agent, sid, cwd, title in rows[:300]:
    print(f"{int(mtime)}\t{agent}\t{sid}\t{cwd}\t{title}")
PY
}

age_of() { # $1 = epoch seconds
  local n=$(( $(date +%s) - ${1:-0} ))
  if   [ "$n" -lt 90 ];    then echo "${n}s"
  elif [ "$n" -lt 3600 ];  then echo "$((n/60))m"
  elif [ "$n" -lt 86400 ]; then echo "$((n/3600))h"
  else echo "$((n/86400))d"
  fi
}

short_path() {
  case "$1" in
    "$HOME"/*) printf '~%s' "${1#"$HOME"}";;
    *) printf '%s' "$1";;
  esac
}

# display-popup restores the client when it closes, which undoes switch-client
# done inside the popup. Write the target here; `agmux follow` runs after the
# popup exits (see agents.conf) and lands on the new window.
follow_write() { # sess window_name
  printf '%s\n%s\n' "$1" "${2:-}" > "$AGMUX_HOME/follow"
}

cmd_follow() {
  local sess win
  [ -f "$AGMUX_HOME/follow" ] || return 0
  { IFS= read -r sess; IFS= read -r win; } < "$AGMUX_HOME/follow" || true
  rm -f "$AGMUX_HOME/follow"
  [ -n "$sess" ] || return 0
  tmux has-session -t "=$sess" 2>/dev/null || return 0
  tmux switch-client -t "=$sess" 2>/dev/null || true
  [ -n "$win" ] && tmux select-window -t "=$sess:$win" 2>/dev/null || true
}

# Start the agent as the window command (not send-keys into a racing shell).
# When the agent exits, exec the user's shell so the window stays as ○ leftover.
start_agent_window() { # sess dir name launch
  local sess="$1" dir="$2" name="$3" launch="$4" pane shell
  shell="${SHELL:-/bin/zsh}"
  pane="$(tmux new-window -t "=$sess" -n "$name" -c "$dir" -P -F '#{pane_id}' \
    "$launch; exec $shell")" \
    || { echo "failed to open tmux window in $sess" >&2; return 1; }
  tmux set-window-option -t "$(tmux display-message -p -t "$pane" '#{window_id}')" automatic-rename off
  follow_write "$sess" "$name"
  printf '%s' "$pane"
}

# Open a saved session in tmux using that CLI's native resume-by-id.
open_history() { # agent id cwd title
  local agent="$1" id="$2" dir="$3" title="$4" sess leaf rel r task pane
  [ -n "$agent" ] && [ -n "$id" ] || return 1
  [ -d "$dir" ] || dir="$PWD"
  rel="$dir"
  while IFS= read -r r; do case "$dir" in "$r"/*) rel="${dir#"$r"/}"; break;; esac; done < <(roots)
  leaf="$(basename "$dir")"
  if [ "$rel" != "$dir" ]; then sess="$(sess_name "$rel")"; else sess="$(printf '%s' "$leaf" | tr '.:' '--')"; fi
  task="$(printf '%s' "${title:-resume}" | tr -c 'a-zA-Z0-9-' '-' | sed 's/^-*//;s/-*$//')"
  task="${task:0:18}"
  [ -z "$task" ] && task="resume"

  if ! tmux has-session -t "=$sess" 2>/dev/null; then
    tmux new-session -d -s "$sess" -c "$dir" -n shell
    tmux set-window-option -t "=$sess:shell" automatic-rename off
  fi
  start_agent_window "$sess" "$dir" "${agent}·${task}" "$(resume_cmd "$agent" "$id")" >/dev/null || return 1
  follow_write "$sess" "${agent}·${task}"
  tmux switch-client -t "=$sess" 2>/dev/null || {
    [ -t 0 ] && tmux attach -t "$sess"
  }
}

agent_from_wname() {
  case "$1" in
    claude·*|claude) echo claude;;
    grok·*|grok) echo grok;;
    opencode·*|opencode) echo opencode;;
    pi·*|pi) echo pi;;
    codex·*|codex) echo codex;;
    *) echo "";;
  esac
}

# Newest saved session for this CLI in this directory. Empty if none.
best_session_id() {
  local agent="$1" dir="$2"
  list_history | awk -F'\t' -v a="$agent" -v d="$dir" '$2==a && $4==d {print $3; exit}'
}

# Restart the authentic CLI in an existing pane (leftover ○ window).
# Prefer resume-by-id for that cwd; otherwise the CLI's own --continue.
restart_in_pane() {
  local pane="$1" wname dir agent id cmd
  [ -n "$pane" ] || return 1
  wname="$(tmux display-message -p -t "$pane" '#{window_name}')"
  dir="$(tmux display-message -p -t "$pane" '#{pane_current_path}')"
  agent="$(agent_from_wname "$wname")"
  [ -n "$agent" ] || { focus "$pane"; return 0; }
  id="$(best_session_id "$agent" "$dir")"
  if [ -n "$id" ]; then
    cmd="$(resume_cmd "$agent" "$id")"
  else
    cmd="$(launch_cmd "$agent" continue)"
  fi
  tmux send-keys -t "$pane" "$cmd" Enter
  focus "$pane"
}

# ttys hosting an agent process: binaries by comm name, plus `pi` (a node script,
# so comm=node; match the invoked path in the command column instead)
agent_ttys() {
  { ps -axo tty=,comm= | awk '$2 ~ /^(claude|opencode|grok|codex)($|-)/ {print $1}'
    ps -axo tty=,command= | awk '{for(i=2;i<=3&&i<=NF;i++) if ($i=="pi" || $i ~ /\/pi$/) {print $1; break}}'
  } | sort -u
}

named_agent() {
  case "$1" in
    claude·*|opencode·*|grok·*|codex·*|pi·*) return 0;;
    *) return 1;;
  esac
}

protected_session() {
  printf '%s' "$1" | grep -Eq "$HUB_SESSIONS"
}

mkdir -p "$AGMUX_HOME" "$WT_DIR"
[ -f "$ROOTS_FILE" ] || printf '%s\n' "$HOME/projects" > "$ROOTS_FILE"

# Phone / ttyd / narrow SSH: single tap accepts, no preview stealing the list.
is_mobile() {
  local w h
  w="$(tmux display-message -p '#{client_width}' 2>/dev/null || echo 120)"
  h="$(tmux display-message -p '#{client_height}' 2>/dev/null || echo 40)"
  [ "${w:-120}" -le 110 ] || [ "${h:-40}" -le 32 ]
}

# Shared fzf. We drop inherited FZF_DEFAULT_OPTS on purpose: finderless (and
# similar layers) export --tmux=center, which nests a second popup inside
# `display-popup` and makes the agent/repo pickers look like they accept a
# row and then do nothing. --no-tmux keeps the list in this window.
fzf_pick() {
  if is_mobile; then
    env -u FZF_DEFAULT_OPTS -u FZF_DEFAULT_COMMAND \
      fzf --no-tmux --layout=reverse --cycle --info=inline --height=100% \
          --no-hscroll --preview-window=hidden \
          --bind 'left-click:accept,double-click:accept' "$@"
  else
    env -u FZF_DEFAULT_OPTS -u FZF_DEFAULT_COMMAND \
      fzf --no-tmux --layout=reverse --cycle --info=inline --height=100% \
          --bind 'left-click:accept,double-click:accept' "$@"
  fi
}

# ---------- project roots ----------
# Every folder listed in ~/.agmux/roots is scanned for git repos. Add a root and
# its repos appear everywhere at once; new repos created inside an existing root
# are picked up automatically on the next rescan (hourly) with no action needed.
roots() { grep -v '^[[:space:]]*\(#.*\)\?$' "$ROOTS_FILE" 2>/dev/null; }

# cache lines are "<display-name>\t<absolute-path>"
scan_repos() {
  local root
  while IFS= read -r root; do
    [ -d "$root" ] || continue
    fd -H -t d --max-depth 6 '^\.git$' "$root" 2>/dev/null \
      | sed -e 's|/\.git/*$||' \
      | while IFS= read -r p; do printf '%s\t%s\n' "${p#"$root"/}" "$p"; done
    # a root that is itself a repo counts as a project too.
    # NB: trailing `:` keeps the loop's exit status zero — under `pipefail` a
    # failing final test would sink the whole pipeline and skip the mv below.
    [ -d "$root/.git" ] && printf '%s\t%s\n' "$(basename "$root")" "$root"
    :
  done < <(roots) | sort -u > "$CACHE.tmp" && mv "$CACHE.tmp" "$CACHE"
}

repos() { # display names only
  if [ ! -s "$CACHE" ]; then scan_repos
  elif [ -n "$(find "$CACHE" -mmin +60 2>/dev/null)" ]; then (scan_repos &) fi
  cut -f1 "$CACHE"
}

repo_path() { awk -F'\t' -v n="$1" '$1==n {print $2; exit}' "$CACHE"; }

# write the tmux leader/prefix key chosen at install time
set_prefix() {
  local key="$1"
  { printf 'unbind C-b\n'
    printf 'set -g prefix %s\n' "$key"
    printf 'bind %s send-prefix\n' "$key"
  } > "$AGMUX_HOME/prefix.conf"
  tmux source-file "$HOME/.tmux.conf" 2>/dev/null
  echo "leader key set to $key"
}

cmd_root() {
  local sub="${1:-list}" p
  case "$sub" in
    add)
      p="$(cd "${2:?usage: agmux root add <path>}" 2>/dev/null && pwd)" \
        || { echo "no such directory: $2" >&2; return 1; }
      roots | grep -qxF "$p" && { echo "already a root: $p"; return 0; }
      printf '%s\n' "$p" >> "$ROOTS_FILE"
      scan_repos
      printf 'added root %s  (%s projects known)\n' "$p" "$(wc -l < "$CACHE" | tr -d ' ')"
      ;;
    rm|remove)
      p="${2:?usage: agmux root rm <path>}"; p="${p%/}"
      grep -vxF "$p" "$ROOTS_FILE" > "$ROOTS_FILE.tmp" && mv "$ROOTS_FILE.tmp" "$ROOTS_FILE"
      scan_repos; echo "removed root $p"
      ;;
    list|"") roots;;
    *) echo "usage: agmux root add|rm|list [path]" >&2; return 1;;
  esac
}

# session name: <workspace>/<leaf>, sanitized for tmux (no '.' or ':')
sess_name() { # $1 = repo relpath
  local ws leaf
  ws="${1%%/*}"; leaf="$(basename "$1")"
  printf '%s/%s' "$ws" "$leaf" | tr '.:' '--'
}

# ---------- claude roster (public JSON surface, read-only) ----------
# emits: <tty-basename> <status> <waitingFor>
claude_roster() {
  claude agents --json 2>/dev/null | jq -r '
    .[] | select(.pid != null)
        | [(.pid|tostring), (.status // "?"), (.waitingFor // "-")] | @tsv' 2>/dev/null \
  | while IFS=$'\t' read -r pid status wf; do
      tty="$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')"
      [ -n "$tty" ] && [ "$tty" != "??" ] && printf '%s\t%s\t%s\n' "$tty" "$status" "${wf// /_}"
    done
}

# ---------- agent pane listing ----------
# emits sorted lines: <rank>\t<glyph> <label>\t<sess>:<win>\t<pane_id>
# Live processes first. Named windows whose agent already exited still appear
# (glyph ○) so they can be jumped to or swept without opening them.
agent_panes() {
  local panes procs roster
  panes="$(tmux list-panes -a -F '#{pane_id}	#{session_name}	#{window_index}	#{window_name}	#{pane_tty}	#{pane_current_path}	#{pane_title}' 2>/dev/null)" || return 0
  procs="$(agent_ttys)"
  roster="$(claude_roster)"

  printf '%s\n' "$panes" | while IFS=$'\t' read -r pid sess win wname ptty ppath ptitle; do
    protected_session "$sess" && continue
    tty_base="${ptty##*/}"
    live=0
    printf '%s\n' "$procs" | grep -qx "$tty_base" && live=1
    if [ "$live" -eq 0 ]; then
      named_agent "$wname" || continue
    fi
    status="run"; wf="-"
    if [ "$live" -eq 1 ]; then
      line="$(printf '%s\n' "$roster" | awk -F'\t' -v t="$tty_base" '$1==t {print $2"\t"$3; exit}')"
      [ -n "$line" ] && { status="${line%%	*}"; wf="${line#*	}"; }
      case "$ptitle" in *"Action Required"*) status="waiting"; wf="approval";; esac
    else
      status="leftover"; wf="-"
    fi
    case "$status" in
      waiting) rank=0; glyph="✋";;
      leftover) rank=3; glyph="○";;
      busy|working) rank=1; glyph="▶";;
      idle) rank=2; glyph="·";;
      *) rank=1; glyph="▶";;
    esac
    rel="$ppath"
    while IFS= read -r r; do case "$ppath" in "$r"/*) rel="${ppath#"$r"/}"; break;; esac; done < <(roots)
    if [ "$rel" = "$ppath" ]; then
      case "$ppath" in "$HOME"*) rel="~${ppath#"$HOME"}";; *) rel="$ppath";; esac
    fi
    extra=""; [ "$wf" != "-" ] && extra=" (${wf//_/ })"
    [ "$status" = "leftover" ] && extra=" (done, chat kept)"
    printf '%s\t%s %s  %s%s\t%s:%s\t%s\n' "$rank" "$glyph" "$wname" "$rel" "$extra" "$sess" "$win" "$pid"
  done | sort -t"$(printf '\t')" -k1,1 -k2,2
}

focus() { # $1 = pane_id
  local target label
  target="$(tmux display-message -p -t "$1" '#{session_name}:#{window_index}')" || return 1
  label="$(tmux display-message -p -t "$1" '#{window_name}')"
  tmux select-pane -t "$1"
  if tmux list-clients >/dev/null 2>&1 && [ -n "$(tmux list-clients -F '#{client_tty}' 2>/dev/null)" ]; then
    tmux switch-client -t "$target" 2>/dev/null || true
  elif [ -t 0 ]; then
    tmux attach -t "$target"
  fi
  printf 'jumped to %s  (%s)\n' "$label" "$target"
  follow_write "${target%%:*}" "$label"
}

# ---------- commands ----------
# Always-on action rows for the agents picker. These sit above live panes so
# a swept-empty list is still a spawn menu, never a dead 0/0 prompt.
picker_actions() {
  printf 'here\t+  new agent\t\t\n'
  printf 'new\tn  pick repo, then agent\t\t\n'
  printf 'search\t/  search the web\t\t\n'
}

# Jump to a live/leftover pane whose label matches the query (case-insensitive).
cmd_jump_query() {
  local q="$1" sel pane glyph
  [ -n "$q" ] || return 1
  sel="$(agent_panes | awk -F'\t' -v q="$q" 'BEGIN{IGNORECASE=1} index($2,q) || index($3,q) {print; exit}')"
  [ -n "$sel" ] || { echo "no agent matched: $q" >&2; return 1; }
  pane="$(printf '%s' "$sel" | awk -F'\t' '{print $4}')"
  glyph="$(printf '%s' "$sel" | awk -F'\t' '{print $2}')"
  if printf '%s' "$glyph" | grep -q '^○'; then
    restart_in_pane "$pane"
  else
    focus "$pane"
  fi
}

cmd_pick() {
  local sel action pane header glyph
  header='type a name to jump (turbopuffer). + new is at the bottom. ○ leftover restarts that CLI.'
  # Agents first so reverse-layout + Enter jumps, not spawn.
  sel="$(
    {
      agent_panes | awk -F'\t' '
        $2 ~ /^○/ { printf "restart\t%s\t%s\t%s\n", $2, $3, $4; next }
        { printf "jump\t%s\t%s\t%s\n", $2, $3, $4 }
      '
      picker_actions
    } | fzf_pick --ansi --delimiter='\t' --with-nth=2,3 \
        --prompt='agents> ' --header="$header" \
        --preview='[ -n "{4}" ] && [[ "{4}" == %* ]] && tmux capture-pane -ep -t {4} | tail -25' \
        --preview-window=down,40%
  )" || return 0
  action="$(printf '%s' "$sel" | awk -F'\t' '{print $1}')"
  pane="$(printf '%s' "$sel" | awk -F'\t' '{print $4}')"
  case "$action" in
    new)     cmd_new ;;
    here)    cmd_here ;;
    search)  cmd_search ;;
    jump)    [ -n "$pane" ] && focus "$pane" ;;
    restart) restart_in_pane "$pane" ;;
  esac
}

pick_start_mode() {
  local sel
  sel="$(printf '%s\n' \
      'new	new conversation' \
      'continue	continue last chat in this repo' \
      'pick	pick a past session from disk' \
    | fzf_pick --delimiter='\t' --with-nth=2 \
        --prompt='start> ' --header='chats are never lost. continue last or pick one.')" || return 1
  printf '%s' "${sel%%	*}"
}

spawn_in() { # $1 = absolute repo dir  $2 = optional start mode (new|continue|pick)
  local dir="$1" forced_mode="${2:-}" agent sess leaf rel task start pane
  agent="$(printf '%s\n' "$AGENT_CHOICES" | fzf_pick --prompt='agent> ' \
            --header="tap an agent to launch in $(basename "$dir"). resume is a separate row in the menu.")" || return 0
  [ -z "$agent" ] && return 0

  rel="$dir"
  while IFS= read -r r; do case "$dir" in "$r"/*) rel="${dir#"$r"/}"; break;; esac; done < <(roots)
  leaf="$(basename "$dir")"
  if [ "$rel" != "$dir" ]; then sess="$(sess_name "$rel")"; else sess="$(printf '%s' "$leaf" | tr '.:' '--')"; fi

  if ! tmux has-session -t "=$sess" 2>/dev/null; then
    tmux new-session -d -s "$sess" -c "$dir" -n shell
    tmux set-window-option -t "=$sess:shell" automatic-rename off
  fi

  if [ "$agent" = "shell" ]; then
    tmux new-window -t "=$sess" -c "$dir"
  else
    # One tap launches. Extra pickers after "claude" were why spawn looked dead:
    # start-mode fzf, a typed task name, then a worktree fzf, any of which
    # aborting (or failing inside display-popup) dropped the whole spawn.
    start="${forced_mode:-new}"
    if [ "$start" = "pick" ]; then
      cmd_resume "$agent" "$dir"
      return
    fi
    task="$(date +%H%M%S)"
    start_agent_window "$sess" "$dir" "${agent}·${task}" "$(launch_cmd "$agent" "$start")" >/dev/null || return 1
  fi

  follow_write "$sess" "${agent}·${task}"
  tmux switch-client -t "=$sess" 2>/dev/null || {
    [ -t 0 ] && tmux attach -t "$sess"
  }
}

cmd_new() {
  local repo
  repo="$(repos | fzf_pick --prompt='repo> ' --header='where should the agent run?')" || return 0
  [ -z "$repo" ] && return 0
  spawn_in "$(repo_path "$repo")"
}

# spawn in the repo you're already standing in — no repo picker
cmd_here() {
  local root
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || root="$PWD"
  spawn_in "$root"
}

# Browse chats the CLIs already saved. Optional filters: agent, then cwd.
# Always restarts the same CLI. Claude stays Claude.
cmd_resume() {
  local want_agent="${1:-}" want_cwd="${2:-}" raw sel mtime agent id cwd title age rel
  raw="$(list_history)" || true
  [ -z "$raw" ] && { echo "no saved sessions found"; return 1; }
  if [ -n "$want_agent" ]; then
    raw="$(printf '%s\n' "$raw" | awk -F'\t' -v a="$want_agent" '$2==a')"
  fi
  if [ -n "$want_cwd" ]; then
    local prefer
    prefer="$(printf '%s\n' "$raw" | awk -F'\t' -v d="$want_cwd" '$4==d || index($4,d)==1')"
    [ -n "$prefer" ] && raw="$prefer"
  fi
  [ -z "$raw" ] && { echo "no saved sessions for ${want_agent:-any agent}${want_cwd:+ in $want_cwd}"; return 1; }

  sel="$(
    printf '%s\n' "$raw" | while IFS=$'\t' read -r mtime agent id cwd title; do
      [ -z "$agent" ] && continue
      age="$(age_of "$mtime")"
      rel="$(short_path "$cwd")"
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$agent" "$age" "$rel" "$title" "$id" "$cwd" "$mtime"
    done | fzf_pick --delimiter='\t' --with-nth=1,2,3,4 \
      --prompt='resume> ' \
      --header='tap a chat to restart it in the same CLI. claude stays claude.'
  )" || true
  [ -z "$sel" ] && return 0
  agent="$(printf '%s' "$sel" | awk -F'\t' '{print $1}')"
  title="$(printf '%s' "$sel" | awk -F'\t' '{print $4}')"
  id="$(printf '%s' "$sel" | awk -F'\t' '{print $5}')"
  cwd="$(printf '%s' "$sel" | awk -F'\t' '{print $6}')"
  open_history "$agent" "$id" "$cwd" "$title"
}

# Tap-first menu. Keep this list short and instant: actions, then live/leftover
# panes. Dumping 25 history rows here made "claude" look like a spawn target
# and list_history blocked the menu for ~2s.
cmd_menu() {
  local sel action pane
  sel="$(
    {
      picker_actions
      printf 'resume\t↩  resume a past session\t\t\n'
      printf 'sweep\tx  sweep inactive agents  (chats kept)\t\t\n'
      agent_panes | awk -F'\t' '
        $2 ~ /^○/ { printf "restart\t%s\t%s\t%s\n", $2, $3, $4; next }
        { printf "jump\t%s\t%s\t%s\n", $2, $3, $4 }
      '
    } | fzf_pick --delimiter='\t' --with-nth=2 \
          --prompt='agmux> ' \
          --header='+ new agent → pick claude/grok/…. ↩ resume. / search. x sweep.' \
          --preview='[ -n "{4}" ] && [[ "{4}" == %* ]] && tmux capture-pane -ep -t {4} | tail -20' \
          --preview-window=down,35%
  )" || return 0
  action="$(printf '%s' "$sel" | awk -F'\t' '{print $1}')"
  pane="$(printf '%s' "$sel" | awk -F'\t' '{print $4}')"
  case "$action" in
    new)     exec "$SELF" new ;;
    here)    exec "$SELF" here ;;
    resume)  exec "$SELF" resume ;;
    search)  exec "$SELF" search ;;
    sweep)   exec "$SELF" sweep ;;
    jump)    [ -n "$pane" ] && focus "$pane" ;;
    restart) restart_in_pane "$pane" ;;
  esac
}

# Type a query, open it in the default browser (new tab).
cmd_search() {
  local q enc
  q="$(printf '' | fzf_pick --print-query --prompt='search the web> ' \
        --bind 'enter:print-query+abort' \
        --header='type a query, enter opens your default browser')" || true
  q="$(printf '%s' "$q" | sed -n '1p')"
  [ -z "$q" ] && return 0
  enc="$(python3 -c 'import urllib.parse,sys; print(urllib.parse.quote_plus(sys.argv[1]))' "$q")"
  if command -v open >/dev/null; then
    open "https://www.google.com/search?q=$enc"
  elif command -v xdg-open >/dev/null; then
    xdg-open "https://www.google.com/search?q=$enc"
  else
    echo "no browser opener found (need open or xdg-open)" >&2
    return 1
  fi
}

refresh_status() {
  claude agents --json 2>/dev/null | jq -r '
    [([.[] | select(.status=="waiting")] | length),
     ([.[] | select(.status=="busy" or .status=="working")] | length)] | @tsv' \
    2>/dev/null > "$AGMUX_HOME/status.tmp" && mv "$AGMUX_HOME/status.tmp" "$AGMUX_HOME/status"
}

cmd_status() {
  # never block the status bar: print the cache, refresh in the background if stale
  local f="$AGMUX_HOME/status" blocked=0 busy=0 age now mtime
  now="$(date +%s)"; mtime="$(stat -f %m "$f" 2>/dev/null || echo 0)"
  age=$(( now - mtime ))
  [ "$age" -ge 5 ] && [ ! -f "$f.tmp" ] && (refresh_status &)
  [ -f "$f" ] && { IFS=$'\t' read -r blocked busy < "$f" || true; }
  if [ "${blocked:-0}" -gt 0 ] 2>/dev/null; then printf '✋%s ▶%s' "$blocked" "${busy:-0}"
  elif [ "${busy:-0}" -gt 0 ] 2>/dev/null; then printf '▶%s' "$busy"
  else printf '·'; fi
}

# Close inactive agents without opening them. Chats stay on disk.
#
# Default (safe): leftover ○ everywhere, plus idle · only in *other* sessions.
# Never closes ✋ blocked or ▶ working. Never kills the session you triggered
# this from, and never touches ax-hub / agmux-hub. After the windows go, other
# sessions that now only have the placeholder `shell` (spawn leftover) are
# dropped. Real work sessions (k8s, go-api, hydradb, …) stay.
#
#   agmux sweep           inactive only (recommended)
#   agmux sweep --all     every agent window, still never kills your session
#   agmux sweep --dry-run print the plan
cmd_sweep() {
  local all=0 dry=0 arg rank label target pane sess win attached
  local -a wins=()
  for arg in "$@"; do
    case "$arg" in
      --all) all=1 ;;
      --keep-blocked) : ;; # default already keeps ✋; accepted so old calls still work
      --dry-run|-n) dry=1 ;;
      -h|--help) echo "usage: agmux sweep [--all] [--dry-run]"; return 0 ;;
      *) echo "usage: agmux sweep [--all] [--dry-run]" >&2; return 1 ;;
    esac
  done

  # Every session a human is actually looking at, not "last touched".
  attached="$(tmux list-clients -F '#{client_session}' 2>/dev/null | sort -u)"

  session_is_attached() {
    [ -n "$1" ] && printf '%s\n' "$attached" | grep -qxF "$1"
  }

  while IFS=$'\t' read -r rank label target pane; do
    [ -z "$target" ] && continue
    sess="${target%%:*}"
    protected_session "$sess" && continue
    if [ "$all" -eq 0 ]; then
      # leftover (3) always. idle (2) only in sessions nobody is attached to.
      # keep ✋/▶ everywhere so a sitting-but-live agent is not murdered.
      case "$rank" in
        3) ;;
        2) session_is_attached "$sess" && continue ;;
        *) continue ;;
      esac
    fi
    wins+=("$target")
  done < <(agent_panes)

  # unique session:window
  local uniq="" w
  uniq="$(printf '%s\n' "${wins[@]+"${wins[@]}"}" | awk 'NF && !seen[$0]++')"

  # If we would close every window of an attached session, leave a landing shell.
  if [ -n "$attached" ] && [ -n "$uniq" ]; then
    local s total left
    while IFS= read -r s; do
      [ -z "$s" ] && continue
      total="$(tmux list-windows -t "=$s" -F '#{session_name}:#{window_index}' 2>/dev/null | wc -l | tr -d ' ')"
      left="$(printf '%s\n' "$uniq" | awk -F: -v sess="$s" '$1==sess' | wc -l | tr -d ' ')"
      if [ "$total" -gt 0 ] && [ "$left" -ge "$total" ]; then
        if [ "$dry" -eq 0 ]; then
          tmux new-window -t "=$s" -n shell
          echo "kept    $s (landed on a new shell window)"
        else
          echo "dry     would add a shell window in $s so you are not detached"
        fi
      fi
    done <<< "$attached"
  fi

  local closed=0
  while IFS= read -r w; do
    [ -z "$w" ] && continue
    sess="${w%%:*}"
    win="${w#*:}"
    if [ "$dry" -eq 1 ]; then
      echo "dry     window $w"
    else
      if tmux kill-window -t "=${sess}:${win}" 2>/dev/null; then
        echo "closed  window $w"
        closed=$((closed+1))
      else
        echo "skip    window $w (already gone)"
      fi
    fi
  done <<< "$uniq"

  # Other sessions that now only hold the spawn placeholder are clutter.
  # Never the attached session. Never a session with a real work window.
  local s names n leftover_sess=0
  while IFS= read -r s; do
    [ -z "$s" ] && continue
    protected_session "$s" && continue
    session_is_attached "$s" && continue
    names="$(tmux list-windows -t "=$s" -F '#{window_name}' 2>/dev/null || true)"
    [ -z "$names" ] && continue
    n="$(printf '%s\n' "$names" | wc -l | tr -d ' ')"
    if [ "$n" = "1" ] && [ "$names" = "shell" ]; then
      leftover_sess=$((leftover_sess+1))
      if [ "$dry" -eq 1 ]; then
        echo "dry     session $s (only leftover shell)"
      else
        tmux kill-session -t "=$s" 2>/dev/null && echo "closed  session $s (only leftover shell)"
      fi
    fi
  done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)

  if [ "$dry" -eq 1 ]; then
    echo "-- dry-run, nothing closed"
  else
    echo "-- closed $closed inactive agent window(s). chats are on disk: agmux resume"
    tmux display-message -d 2500 "agmux: swept $closed inactive agent(s). chats kept." 2>/dev/null || true
  fi
}

# Remove worktrees that are safe to drop. A worktree is kept if any tmux pane
# is inside it (agent still running), it has uncommitted changes, or its branch
# has commits not yet in the main checkout's branch (prints the merge command).
cmd_clean() {
  local wt branch mainwt base ahead cwds removed=0 kept=0
  cwds="$(tmux list-panes -a -F '#{pane_current_path}' 2>/dev/null)"
  for wt in "$WT_DIR"/*/ "$LEGACY_WT"/*/ "$LEGACY_WT2"/*/; do
    [ -d "$wt" ] || continue
    wt="${wt%/}"
    if printf '%s\n' "$cwds" | awk -v p="$wt" 'index($0,p)==1{f=1} END{exit !f}'; then
      printf 'keep    %-40s (agent pane inside)\n' "$(basename "$wt")"; kept=$((kept+1)); continue
    fi
    if [ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ]; then
      printf 'keep    %-40s (uncommitted changes)\n' "$(basename "$wt")"; kept=$((kept+1)); continue
    fi
    branch="$(git -C "$wt" branch --show-current 2>/dev/null)"
    mainwt="$(git -C "$wt" worktree list --porcelain 2>/dev/null | awk '$1=="worktree"{print $2; exit}')"
    [ -z "$mainwt" ] && { printf 'skip    %-40s (not a worktree?)\n' "$(basename "$wt")"; continue; }
    base="$(git -C "$mainwt" symbolic-ref --short HEAD 2>/dev/null || echo main)"
    ahead="$(git -C "$wt" rev-list --count "$base..HEAD" 2>/dev/null || echo '?')"
    if [ "$ahead" = "0" ]; then
      if git -C "$mainwt" worktree remove "$wt" 2>/dev/null; then
        [ -n "$branch" ] && git -C "$mainwt" branch -d "$branch" >/dev/null 2>&1
        printf 'removed %-40s (merged / no unique commits)\n' "$(basename "$wt")"
        removed=$((removed+1))
      else
        printf 'keep    %-40s (git refused removal)\n' "$(basename "$wt")"; kept=$((kept+1))
      fi
    else
      printf 'keep    %-40s (%s commits not in %s)\n' "$(basename "$wt")" "$ahead" "$base"
      printf '        merge with: git -C %s merge %s   then re-run agmux clean\n' "$mainwt" "$branch"
      kept=$((kept+1))
    fi
  done
  printf -- '-- removed %s, kept %s\n' "$removed" "$kept"
}

cmd_web() {
  local ts_ip tsout
  case "${1:-on}" in
    on)
      command -v ttyd >/dev/null || { echo "installing ttyd..."; brew install ttyd; }
      pkill -f 'ttyd.*(ax-hub|agmux-hub)' 2>/dev/null; command sleep 0.3
      # try the nice path first: HTTPS + MagicDNS via tailscale serve.
      # NB: if Serve isn't enabled on the tailnet, the CLI prints an enable
      # URL and then blocks polling for enablement — so probe with a timeout.
      tailscale serve --bg 7681 </dev/null >"$AGMUX_HOME/serve.out" 2>&1 &
      local spid=$!; local i=0
      while kill -0 "$spid" 2>/dev/null && [ "$i" -lt 8 ]; do command sleep 0.5; i=$((i+1)); done
      kill "$spid" 2>/dev/null; wait "$spid" 2>/dev/null
      tsout="$(cat "$AGMUX_HOME/serve.out" 2>/dev/null)"
      if printf '%s' "$tsout" | grep -q 'not enabled'; then
        # Serve not enabled on tailnet -> bind the tailscale IP directly.
        # Still tailnet-only and WireGuard-encrypted, just no TLS/MagicDNS.
        ts_ip="$(tailscale ip -4 2>/dev/null | head -1)"
        [ -z "$ts_ip" ] && { echo "tailscale not connected" >&2; return 1; }
        (nohup ttyd -i "$ts_ip" -p 7681 -W -t fontSize=18 -t 'theme={"background":"#282a36"}' \
          tmux new -A -s agmux-hub >/dev/null 2>&1 &)
        echo "browser terminal (tailnet-only): http://$ts_ip:7681"
        echo "for HTTPS + a proper URL, enable Serve once as tailnet admin:"
        printf '%s\n' "$tsout" | grep 'https://' | tr -d ' '
      else
        (nohup ttyd -i 127.0.0.1 -p 7681 -W -t fontSize=18 -t 'theme={"background":"#282a36"}' \
          tmux new -A -s agmux-hub >/dev/null 2>&1 &)
        echo "browser terminal (tailnet-only): https://$(tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // ""' | sed 's|\.$||')/"
      fi
      ;;
    off)
      pkill -f 'ttyd.*(ax-hub|agmux-hub)' 2>/dev/null
      tailscale serve reset >/dev/null 2>&1
      echo "browser terminal stopped"
      ;;
    *) echo "usage: agmux web on|off" >&2; return 1;;
  esac
}

case "${1:-pick}" in
  pick|"") cmd_pick;;
  new) cmd_new;;
  here) cmd_here;;
  resume) cmd_resume;;
  search) cmd_search;;
  follow) cmd_follow;;
  sweep) shift; cmd_sweep "$@";;
  clean) cmd_clean;;
  menu) cmd_menu;;
  path) sel="$(repos | fzf_pick --prompt='repo> ')" && [ -n "$sel" ] && repo_path "$sel";;
  status) cmd_status;;
  root) shift; cmd_root "$@";;
  prefix) set_prefix "${2:?usage: agmux prefix <key>   e.g. C-a, C-Space, C-b}";;
  repos) scan_repos; wc -l < "$CACHE" | tr -d ' '; echo "repos cached";;
  jump) focus "${2:?pane id required}";;
  web) shift; cmd_web "${1:-on}";;
  panes) agent_panes;;  # debug
  # Print the header comment block: every line from line 2 until the first
  # non-comment line. A hardcoded range ('2,12p') silently truncated the help
  # the moment a command was added below line 12 — `clean`, `web`, `repos` and
  # `jump` all existed and were undocumented because of it. This cannot drift.
  help|-h|--help) sed -n '2,${/^#/!q;s/^# \{0,1\}//;p;}' "$SELF"; exit 0;;
  *) cmd_jump_query "$*" ;;
esac
